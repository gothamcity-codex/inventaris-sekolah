generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Barang {
  id       Int    @id @default(autoincrement())
  nama     String
  kategori String
  jumlah   Int
  ruangan  String
  kondisi  String
}
